{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "none",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "css",
  "plugins": [
    "prettier-plugin-astro"
  ],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro",
        "tabWidth": 2,
        "useTabs": false,
        "printWidth": 80
      }
    },
    {
      "files": "*.vue",
      "options": {
        "parser": "vue",
        "tabWidth": 2,
        "useTabs": false,
        "printWidth": 80
      }
    }
  ]
}
